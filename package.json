{
  "name": "woodshop-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --tsconfig server/tsconfig.json --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "build": "npm run typecheck && vite build",
    "start": "tsx --tsconfig server/tsconfig.json --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p server && tsc -p web",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@supabase/supabase-js": "^2.119.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
